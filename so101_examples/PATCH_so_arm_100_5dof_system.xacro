<!--
  PATCH REFERENCE for your so_arm_100_5dof_system macro
  (the file with params="name prefix initial_positions_file:=^|'' use_sim:=^|false ...")

  This is not a new file to include -- it shows exactly what to change in your
  EXISTING so_*.ros2_control.xacro file. Two changes only:

    1. Replace the real-hardware <xacro:unless value="${use_fake_hardware}"> block
    2. Replace the six joint blocks' <param name="min">/<param name="max"> with your
       real URDF limits (currently all six use a generic +/-3.14 placeholder, but
       your actual so_arm_100_5dof_arm.urdf.xacro has different real limits per
       joint -- these should match).

  Everything else in your file (the macro signature, use_sim/use_topic_hardware_interface/
  use_fake_hardware branching, the sim and mock_components branches) stays exactly
  as it is. You can also delete the now-unused serial_port / serial_baudrate /
  servo_speed / servo_acceleration params from the macro signature -- the real
  serial port now lives only in feetech_bridge_node's own launch parameters, not
  anywhere in the URDF.
-->

<!-- ============ CHANGE 1: the real-hardware <hardware> block ============ -->

<!-- BEFORE:
  <xacro:unless value="${use_fake_hardware}">
    <plugin>so_arm_100_controller/SOARM100Interface</plugin>
    <param name="use_serial">true</param>
    <param name="serial_port">${serial_port}</param>
    <param name="serial_baudrate">${serial_baudrate}</param>
    <param name="servo_speed">${servo_speed}</param>
    <param name="servo_acceleration">${servo_acceleration}</param>
  </xacro:unless>
-->

<!-- AFTER: -->
<xacro:unless value="${use_fake_hardware}">
  <plugin>so101_hardware/SO101HardwareInterface</plugin>
  <param name="commands_topic">/so101/hardware_commands</param>
  <param name="states_topic">/so101/hardware_states</param>
</xacro:unless>


<!-- ============ CHANGE 2: real per-joint limits ============ -->
<!-- Replace each joint's placeholder min/max (currently -3.14 / 3.14 on all six)
     with the actual limits from so_arm_100_5dof_arm.urdf.xacro. Everything else
     in each joint block (the initial_positions_file xacro:if, state_interface
     lines) stays the same -- only the two <param> values change. -->

<!-- ${prefix}Shoulder_Rotation -->
<param name="min">-1.96</param>
<param name="max">1.96</param>

<!-- ${prefix}Shoulder_Pitch -->
<param name="min">-1.745</param>
<param name="max">1.745</param>

<!-- ${prefix}Elbow -->
<param name="min">-1.5</param>
<param name="max">1.5</param>

<!-- ${prefix}Wrist_Pitch -->
<param name="min">-1.658</param>
<param name="max">1.658</param>

<!-- ${prefix}Wrist_Roll -->
<param name="min">-2.75</param>
<param name="max">2.75</param>

<!-- ${prefix}Gripper: leave this joint block in the file for later, but it plays
     no role yet -- motor 6 isn't installed, so the bridge node will never report
     or accept a position for it. Its limits are already correct if you keep it:
     min -0.1792 / max 1.5708. -->
